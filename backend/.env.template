# Notion Integration Token
# Get yours at: https://www.notion.so/my-integrations
# 1. Click "+ New integration"
# 2. Name it "Mnemify" (or anything you like)
# 3. Select your workspace
# 4. Copy the "Internal Integration Secret"
# 5. IMPORTANT: Share the pages/databases you want to harvest
#    with this integration (page menu → Connections → Add Mnemify)
NOTION_TOKEN=ntn_your_token_here

# Atlassian Credentials (Confluence + Jira)
# Cloud-only. Both plugins use HTTP basic auth with your email + an API token.
# 1. Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
#    Click "Create API token", label it "Mnemify", copy the value once (it is
#    not shown again).
# 2. Set CONFLUENCE_EMAIL / JIRA_EMAIL to the Atlassian account email that owns
#    the token (the one you logged into id.atlassian.com with).
# 3. Set CONFLUENCE_API_TOKEN / JIRA_API_TOKEN to the token value from step 1.
# 4. The schema allows separate tokens per source, but the same token works for
#    both Confluence and Jira on the same Atlassian cloud site — point both
#    *_API_TOKEN vars at the same value if that suits you.
# 5. Fill in your Confluence/Jira base_url + space_keys / project_keys in
#    mnemify.yaml under sources.confluence / sources.jira.
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_atlassian_api_token_here
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google (Gmail + Calendar)
# Unlike Notion/Atlassian, Google uses OAuth, not a token. You don't put a
# secret in this file — you drop a JSON client config into the repo. Setup:
#   1. https://console.cloud.google.com/  → create a project named "Mnemify".
#   2. APIs & Services → Library → enable: Gmail API, Google Calendar API.
#   3. APIs & Services → OAuth consent screen → User type "External".
#      Add scopes:
#        https://www.googleapis.com/auth/gmail.readonly
#        https://www.googleapis.com/auth/calendar.readonly
#      Add your own email under "Test users" (no Google verification needed
#      while the app is in Testing mode — up to 100 test users allowed).
#   4. APIs & Services → Credentials → Create credentials → OAuth client ID
#      → Application type "Desktop app" → name "Mnemify Desktop" →
#      Download JSON.
#   5. Rename the downloaded file to oauth_client.json and place it at:
#        backend/src/harvester/_google/oauth_client.json
#      (this path is gitignored — your client secret never enters git.)
#   6. Then per Google service, run the one-time consent flow:
#        mnemify login --source gmail
#        mnemify login --source calendar
#      The refresh tokens are cached at ~/.mnemify/google/<service>-token.json
#      (mode 0600) and reused on every subsequent harvest.
# GMAIL_CREDENTIALS_PATH and CALENDAR_CREDENTIALS_PATH are *optional*
# power-user overrides that point at an alternate client_secret JSON
# (e.g. your own Google Cloud project). The bundled file above is what
# every normal user takes.

# Slack User Token
# Mnemify uses a Slack App you install in your own workspace. Setup:
#   1. https://api.slack.com/apps → "Create New App" → "From scratch" →
#      name "Mnemify" → pick your workspace.
#   2. "OAuth & Permissions" → "User Token Scopes" → add (verified
#      against api.slack.com/scopes; user-scope, not bot-scope):
#        channels:history, channels:read    (public channels)
#        groups:history, groups:read        (private channels)
#        im:history, im:read                (DMs)
#        mpim:history, mpim:read            (group DMs)
#        users:read                         (resolve @-mentions)
#        files:read                         (download file attachments)
#        team:read                          (workspace permalink prefix)
#   3. "Install to Workspace" → approve.
#   4. Copy the "User OAuth Token" (starts with xoxp-).
#   5. For private channels, you must also be a member of every channel
#      listed under sources.slack.channels in mnemify.yaml — user
#      tokens inherit your Slack client's membership.
SLACK_USER_TOKEN=xoxp-your_slack_user_token_here

# GitHub Personal Access Token
# Fine-grained PATs recommended (gained GraphQL support in April 2025,
# so Discussions work). Classic PAT with scopes `repo` + `read:discussion`
# is a valid fallback. Setup for fine-grained:
#   1. https://github.com/settings/personal-access-tokens/new
#   2. Resource owner → user or org whose repos you'll harvest.
#   3. Repository access → "Only select repositories" → pick the repos
#      you list under sources.github.repos in mnemify.yaml.
#   4. Repository permissions → set Read for: Contents, Metadata, Issues,
#      Pull requests, Discussions.
#   5. Generate; copy the token (starts with github_pat_).
# For GitHub Enterprise Server, override api_base and graphql_endpoint
# in the YAML block.
GITHUB_TOKEN=github_pat_your_token_here